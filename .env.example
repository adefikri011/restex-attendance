# Runtime application connection (Neon pooled connection string)
DATABASE_URL=

# Prisma migrations and schema management (Neon direct, non-pooled connection string)
DIRECT_URL=

# Public application origin used by Better Auth
BETTER_AUTH_URL=http://localhost:3000

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional one-time credential for creating the first Super Admin.
# Generate with: openssl rand -base64 48
INITIAL_ADMIN_TOKEN=
