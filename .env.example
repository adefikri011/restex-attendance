# Runtime application connection (Neon pooled connection string)
DATABASE_URL=

# Prisma migrations and schema management (Neon direct, non-pooled connection string)
DIRECT_URL=

# Public application origin used by Better Auth
BETTER_AUTH_URL=http://192.168.1.13:3000

# Optional extra development origins, comma-separated (for LAN access alongside a tunnel)
BETTER_AUTH_TRUSTED_ORIGINS=

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudflare Turnstile keys for the login widget.
# The site key is public; the secret key must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Stable secret for signed member attendance QR codes (at least 32 characters).
# Generate with: openssl rand -base64 32
QR_TOKEN_SECRET=

# Optional one-time credential for creating the first Super Admin.
# Generate with: openssl rand -base64 48
INITIAL_ADMIN_TOKEN=

# Cloudflare R2 (create an API token with Object Read & Write for this bucket).
# Keep these values server-side; never expose them with a NEXT_PUBLIC_ prefix.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=restex-attendance
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
