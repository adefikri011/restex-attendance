generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DIVISION_LEAD
  DIVISION_PJ
  CANDIDATE
  MEMBER

  @@map("user_role")
}

enum MembershipStatus {
  ACTIVE
  ON_LEAVE
  EXITED
  ALUMNI

  @@map("membership_status")
}

enum ActivityType {
  ROUTINE
  WORKSHOP
  SEMINAR
  INTERNAL
  OTHER

  @@map("activity_type")
}

enum SessionStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@map("session_status")
}

enum AttendanceStatus {
  PRESENT
  EXCUSED
  SICK
  ABSENT

  @@map("attendance_status")
}

enum AttendanceMethod {
  QR
  MANUAL

  @@map("attendance_method")
}

enum ApplicantStage {
  SUBMITTED
  SCREENING
  MEETING_INVITED
  FORM_TWO_OPEN
  FORM_TWO_SUBMITTED
  FINAL_REVIEW

  @@map("applicant_stage")
}

enum ApplicantDecision {
  ACCEPTED
  REJECTED
  WAITLISTED

  @@map("applicant_decision")
}

enum ApplicantMeetingMode {
  IN_PERSON
  ONLINE

  @@map("applicant_meeting_mode")
}

enum ApplicantScreeningRating {
  RECOMMENDED
  CONSIDER
  NOT_RECOMMENDED

  @@map("applicant_screening_rating")
}

enum ApplicantMeetingAttendance {
  PRESENT
  ABSENT

  @@map("applicant_meeting_attendance")
}

model Period {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(20)
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  isActive    Boolean      @default(false) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships Membership[]
  sessions    Session[]

  @@index([isActive])
  @@map("periods")
}

model RecruitmentSetting {
  id          String    @id @default("global") @db.VarChar(20)
  open        Boolean   @default(false)
  opensAt     DateTime? @map("opens_at") @db.Date
  closesAt    DateTime? @map("closes_at") @db.Date
  registerUrl String    @default("") @map("register_url") @db.VarChar(2048)
  notifyUrl   String    @default("") @map("notify_url") @db.VarChar(2048)
  zoomEnabled Boolean   @default(false) @map("zoom_enabled")
  zoomUrl     String    @default("") @map("zoom_url") @db.VarChar(2048)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("recruitment_settings")
}

model RecruitmentMeetingSession {
  id           String                   @id @default(uuid()) @db.Uuid
  title        String                   @db.VarChar(120)
  startsAt     DateTime                 @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime                 @map("ends_at") @db.Timestamptz(3)
  location     String                   @db.VarChar(240)
  capacity     Int
  isActive     Boolean                  @default(true) @map("is_active")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  applications RecruitmentApplication[]

  @@index([isActive, startsAt])
  @@map("recruitment_meeting_sessions")
}

model StudyProgram {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String                   @db.VarChar(160)
  normalizedName String                   @unique @map("normalized_name") @db.VarChar(160)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  applications   RecruitmentApplication[]

  @@index([name])
  @@map("study_programs")
}

model RecruitmentApplication {
  id                String                      @id @default(uuid()) @db.Uuid
  userId            String                      @unique @map("user_id") @db.Uuid
  fullName          String                      @map("full_name") @db.VarChar(160)
  nim               String                      @db.VarChar(32)
  email             String                      @db.VarChar(254)
  studyProgramId    String                      @map("study_program_id") @db.Uuid
  cohort            String                      @db.VarChar(4)
  motivation        String?                     @db.Text
  stage             ApplicantStage              @default(SUBMITTED)
  decision          ApplicantDecision?
  division          String?                     @db.VarChar(100)
  divisionReason    String?                     @map("division_reason") @db.Text
  experience        String?                     @db.Text
  screeningRating   ApplicantScreeningRating?   @map("screening_rating")
  meetingMode       ApplicantMeetingMode?       @map("meeting_mode")
  meetingSessionId  String?                     @map("meeting_session_id") @db.Uuid
  meetingAttendance ApplicantMeetingAttendance? @map("meeting_attendance")
  meetingNotes      String?                     @map("meeting_notes") @db.Text
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram      StudyProgram                @relation(fields: [studyProgramId], references: [id], onDelete: Restrict)
  meetingSession    RecruitmentMeetingSession?  @relation(fields: [meetingSessionId], references: [id], onDelete: Restrict)

  @@unique([nim])
  @@index([stage, createdAt])
  @@index([meetingSessionId])
  @@map("recruitment_applications")
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder, name])
  @@map("divisions")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(120)
  email                  String                  @unique @db.VarChar(254)
  passwordHash           String?                 @map("password_hash") @db.VarChar(255)
  emailVerified          Boolean                 @default(false) @map("email_verified")
  image                  String?                 @db.VarChar(2048)
  role                   UserRole                @default(MEMBER)
  isActive               Boolean                 @default(true) @map("is_active")
  managedDivision        String?                 @map("managed_division") @db.VarChar(100)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  member                 Member?
  createdSessions        Session[]               @relation("SessionCreator")
  attendances            Attendance[]            @relation("AttendanceRecorder")
  auditLogs              AuditLog[]
  authSessions           AuthSession[]
  accounts               Account[]
  recruitmentApplication RecruitmentApplication?

  @@index([role, isActive])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.VarChar(191)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.VarChar(191)
  accountId             String    @map("account_id") @db.VarChar(191)
  providerId            String    @map("provider_id") @db.VarChar(191)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.VarChar(191)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model Member {
  id          String       @id @default(uuid()) @db.Uuid
  memberCode  String       @unique @map("member_code") @db.VarChar(24)
  fullName    String       @map("full_name") @db.VarChar(160)
  nim         String       @unique @db.VarChar(32)
  cohort      String       @db.VarChar(4)
  photoUrl    String?      @map("photo_url") @db.VarChar(2048)
  qrTokenHash String?      @unique @map("qr_token_hash") @db.VarChar(128)
  qrIssuedAt  DateTime?    @map("qr_issued_at") @db.Timestamptz(3)
  qrRevokedAt DateTime?    @map("qr_revoked_at") @db.Timestamptz(3)
  userId      String?      @unique @map("user_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships Membership[]
  attendances Attendance[]

  @@index([fullName])
  @@index([cohort])
  @@map("members")
}

model Membership {
  id       String           @id @default(uuid()) @db.Uuid
  memberId String           @map("member_id") @db.Uuid
  periodId String           @map("period_id") @db.Uuid
  division String           @db.VarChar(100)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  endedAt  DateTime?        @map("ended_at") @db.Timestamptz(3)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  period   Period           @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([memberId, periodId])
  @@index([periodId, status])
  @@index([periodId, division])
  @@map("memberships")
}

model Session {
  id          String        @id @default(uuid()) @db.Uuid
  periodId    String        @map("period_id") @db.Uuid
  title       String        @db.VarChar(120)
  type        ActivityType
  scheduledAt DateTime      @map("scheduled_at") @db.Timestamptz(3)
  location    String        @db.VarChar(160)
  notes       String?       @db.VarChar(1000)
  division    String?       @db.VarChar(100)
  status      SessionStatus @default(DRAFT)
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  period      Period        @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendances Attendance[]

  @@index([periodId, status, scheduledAt])
  @@index([periodId, division, status, scheduledAt])
  @@index([createdById])
  @@map("sessions")
}

model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  sessionId    String           @map("session_id") @db.Uuid
  memberId     String           @map("member_id") @db.Uuid
  status       AttendanceStatus
  method       AttendanceMethod
  reason       String?          @db.VarChar(240)
  recordedAt   DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedById String?          @map("recorded_by_id") @db.Uuid
  session      Session          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  recordedBy   User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, memberId])
  @@index([memberId, recordedAt])
  @@index([sessionId, status])
  @@map("attendances")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  oldValue   Json?    @map("old_value") @db.JsonB
  newValue   Json?    @map("new_value") @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([entity, entityId])
  @@index([userId, occurredAt])
  @@map("audit_logs")
}
